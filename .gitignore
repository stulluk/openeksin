# Gradle
.gradle/
build/
app/build/
/captures/
/.kotlin/

# Android Studio / IntelliJ
*.iml
.idea/
local.properties

# Build env artifacts created by the Docker build (mapped HOME=/work)
/.android/
/.config/
/.java/

# Signing (the standard non-secret debug keystore is committed for stable
# debug signatures; real release keys must never be committed)
*.keystore
*.jks
!keystore/debug.keystore

# APK output
*.apk
*.idsig

# Secrets / local credentials (never commit)
.secrets/
*.env
.env*

# OS
.DS_Store

# Root-level working screenshots (curated copies live in docs/)
/screenshot_*.png
/test-screenshots/
/test_screenshots/
